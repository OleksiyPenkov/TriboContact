        <DCCReference Include="src\core\TriboContact.ElasticLayered.pas"/>
        <DCCReference Include="src\core\TriboContact.CcxManager.pas"/>
        <DCCReference Include="src\core\TriboContact.FemMesh.pas"/>
        <DCCReference Include="src\core\TriboContact.FemCalculix.pas"/>
        <DCCReference Include="src\core\TriboContact.Runner.pas"/>
        <DCCReference Include="src\core\TriboContact.PlotRenderer.pas"/>
        <DCCReference Include="src\core\TriboContact.Export.pas"/>
        <DCCReference Include="src\gui\TriboContact.Worker.pas"/>
        <DCCReference Include="src\gui\TriboContact.LayerDialog.pas">
            <Form>frmLayerDialog</Form>
            <FormType>dfm</FormType>
        </DCCReference>
        <DCCReference Include="src\gui\TriboContact.MaterialDialog.pas">
            <Form>frmMaterialDialog</Form>
            <FormType>dfm</FormType>
        </DCCReference>
        <DCCReference Include="src\gui\TriboContact.MainForm.pas">
            <Form>frmMain</Form>
            <FormType>dfm</FormType>
        </DCCReference>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>VCLApplication</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">TriboContact.dpr</Source>
                </Source>
            </Delphi.Personality>
        </BorlandProject>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
    <Import Project="$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj" Condition="Exists('$(APPDATA)\Embarcadero\$(BDSAPPDATABASEDIR)\$(PRODUCTVERSION)\UserTools.proj')"/>
